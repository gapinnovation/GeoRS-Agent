{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoRS-Agent structured interpretation",
  "description": "Structure of the structured-mode response (manuscript Sec. 4.5). This schema checks structure only: class and attribute fields are plain strings so that non-canonical outputs can be recorded and audited rather than rejected. Taxonomy compliance is checked separately (see output_schema.strict.json and `georsagent validate`). There is deliberately no numeric score field: the prototype computes no score.",
  "type": "object",
  "required": [
    "scene_interpretation",
    "attribute_analysis",
    "alternative_classes",
    "explanation",
    "uncertainty_note"
  ],
  "properties": {
    "scene_interpretation": {
      "type": "object",
      "required": [
        "predicted_class",
        "confidence"
      ],
      "properties": {
        "predicted_class": {
          "description": "Most plausible class, or several classes when the evidence does not single one out.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "confidence": {
          "description": "Uncalibrated verbal assessment generated by the model (e.g. high, moderate, moderate-to-high). Not a probability.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribute_analysis": {
      "type": "object",
      "required": [
        "objects",
        "dominant_colours",
        "geometric_patterns"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dominant_colours": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometric_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alternative_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "reason"
        ],
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
