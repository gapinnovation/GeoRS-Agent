{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoRS-Agent structured interpretation (strict taxonomy)",
  "description": "Strict variant of output_schema.json for deterministic output validation: every class field must be one of the 19 canonical WHU-RS19 labels and every attribute a canonical WHU-RS19 ABZSL attribute (exact lowercase strings). Proposed extension (manuscript Sec. 6-7); NOT enforced in the prototype evaluated in the manuscript. Generated from knowledge_base/ by `georsagent export-strict-schema`; do not edit by hand.",
  "type": "object",
  "required": [
    "scene_interpretation",
    "attribute_analysis",
    "alternative_classes",
    "explanation",
    "uncertainty_note"
  ],
  "properties": {
    "scene_interpretation": {
      "type": "object",
      "required": [
        "predicted_class",
        "confidence"
      ],
      "properties": {
        "predicted_class": {
          "description": "Most plausible class, or several classes when the evidence does not single one out.",
          "oneOf": [
            {
              "$ref": "#/$defs/canonicalClass"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/canonicalClass"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "confidence": {
          "description": "Uncalibrated verbal assessment generated by the model (e.g. high, moderate, moderate-to-high). Not a probability.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribute_analysis": {
      "type": "object",
      "required": [
        "objects",
        "dominant_colours",
        "geometric_patterns"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "dominant_colours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dominantColour"
          }
        },
        "geometric_patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/geometricPattern"
          }
        }
      }
    },
    "alternative_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "reason"
        ],
        "properties": {
          "class": {
            "$ref": "#/$defs/canonicalClass"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "canonicalClass": {
      "enum": [
        "airport",
        "beach",
        "bridge",
        "commercial",
        "desert",
        "farmland",
        "football field",
        "forest",
        "industrial",
        "meadow",
        "mountain",
        "park",
        "parking",
        "pond",
        "port",
        "railway station",
        "residential",
        "river",
        "viaduct"
      ]
    },
    "object": {
      "enum": [
        "airplane",
        "road",
        "bridge",
        "road transport",
        "houses",
        "grass",
        "trees",
        "mountains",
        "soil",
        "water",
        "sand",
        "water transport",
        "dock",
        "stadium",
        "football field",
        "buildings",
        "parking spots",
        "rails",
        "trains"
      ]
    },
    "dominantColour": {
      "enum": [
        "red",
        "orange",
        "ochre",
        "beige",
        "green",
        "light blue",
        "blue",
        "brown",
        "gray",
        "white",
        "black"
      ]
    },
    "geometricPattern": {
      "enum": [
        "rectangle",
        "triangle",
        "square",
        "sine wave",
        "line",
        "dashed line",
        "curve",
        "closed curve"
      ]
    }
  }
}
