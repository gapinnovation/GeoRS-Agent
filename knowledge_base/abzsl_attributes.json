{
  "name": "WHU-RS19 ABZSL attribute vocabulary",
  "description": "Controlled attribute vocabulary (38 binary, image-level attributes) used by GeoRS-Agent as semantic evidence. Grouped as 19 objects, 11 dominant colours and 8 geometric patterns, following the WHU-RS19 ABZSL release. 'canonical' is the lowercase form used in agent outputs; 'display_name' is the English name in the dataset release; 'annotation_column' is the original (Italian) column name in the annotation file; 'aliases' lists accepted variants together with their provenance.",
  "source": "Balestra, M., Paolanti, M., Pierdicca, R. (2025). WHU-RS19 ABZSL: An Attribute-Based Dataset for Remote Sensing Image Understanding. Remote Sensing 17(14), 2384. doi:10.3390/rs17142384. Attribute names and grouping taken from the dataset release (github.com/marinapaolanti/WHU-RS19-ABZSL-An-Attribute-Based-Dataset-for-Remote-Sensing-Image-Understanding).",
  "alias_provenance": {
    "manuscript": "Term used for this attribute in the GeoRS-Agent manuscript text or examples.",
    "spelling": "Orthographic variant (e.g., British vs American spelling)."
  },
  "groups": {
    "objects": [
      {"canonical": "airplane",        "display_name": "Airplane",        "annotation_column": "Aereo",                        "aliases": [{"term": "aircraft", "provenance": "manuscript"}]},
      {"canonical": "road",            "display_name": "Road",            "annotation_column": "Strada",                       "aliases": []},
      {"canonical": "bridge",          "display_name": "Bridge",          "annotation_column": "Ponte",                        "aliases": []},
      {"canonical": "road transport",  "display_name": "Road Transport",  "annotation_column": "Mezzi di trasporto su strada", "aliases": []},
